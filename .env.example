# Meta WhatsApp Cloud API Configuration
# Get these credentials from your Meta for Developers Dashboard: https://developers.facebook.com/apps/

# Your WhatsApp Cloud API Permanent or System User Access Token
WHATSAPP_API_TOKEN=your_meta_whatsapp_system_user_access_token_here

# Your WhatsApp Business Phone Number ID (from WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Your Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Webhook Verification Token (custom secret string you set in Meta App Webhook configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gustosa_secret_webhook_verify_token_2026

# Meta API Graph Version (defaults to v21.0)
META_GRAPH_API_VERSION=v21.0
